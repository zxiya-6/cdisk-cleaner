<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>11</LangVersion>
    <RootNamespace>CleanMaster.Cli</RootNamespace>
    <AssemblyName>CleanMasterCli</AssemblyName>
    <Version>5.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanMaster.Core\CleanMaster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="rules" />
  </ItemGroup>

</Project>
