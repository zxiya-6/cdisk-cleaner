<Window x:Class="CleanMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CleanMaster.App.Views"
        Title="C盘清理助手 v5" Height="860" Width="1320" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <!-- 头部 -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="C盘清理助手" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtVersion" Text="v5.0.0" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <Border x:Name="BadgeAdmin" Background="#E7F3E9" BorderBrush="#BCDEC3" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtAdmin" Text="管理员模式" FontSize="11.5" Foreground="{StaticResource SuccessBrush}"/>
          </Border>
          <Button x:Name="BtnElevate" Content="以管理员身份重启" Height="24" FontSize="11.5" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="BtnElevate_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="TxtDisk" Text="C: —" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/>
          <ProgressBar x:Name="BarDisk" Width="120" Height="6" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnRefreshDisk" Content="刷新" Height="24" FontSize="11.5" Padding="8,0" Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnRefreshDisk_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态条 / 进度 -->
    <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" FontSize="12.5"/>
        <ProgressBar Grid.Column="1" x:Name="BarProgress" Margin="14,0" Height="6" VerticalAlignment="Center" Visibility="Collapsed"/>
        <Button Grid.Column="2" x:Name="BtnCancel" Content="停止" Height="26" Padding="14,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
        <TextBlock Grid.Column="3" x:Name="TxtSummary" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
      </Grid>
    </Border>

    <!-- 页签 -->
    <TabControl Grid.Row="2" x:Name="MainTabs" Margin="10,6,10,0" SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="清理">
        <views:CleanView x:Name="CleanViewCtl"/>
      </TabItem>
      <TabItem Header="大文件">
        <views:BigFileView x:Name="BigFileViewCtl"/>
      </TabItem>
      <TabItem Header="备份与恢复">
        <views:BackupView x:Name="BackupViewCtl"/>
      </TabItem>
      <TabItem Header="历史台账">
        <views:HistoryView x:Name="HistoryViewCtl"/>
      </TabItem>
      <TabItem Header="工具">
        <views:ToolsView x:Name="ToolsViewCtl"/>
      </TabItem>
    </TabControl>

    <!-- 底部状态栏 -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <TextBlock x:Name="TxtRulesState" Text="规则库：加载中…" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Text3Brush}"/>
        <TextBlock x:Name="TxtDataDir" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Text3Brush}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
