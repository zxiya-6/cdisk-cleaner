<UserControl x:Class="CleanMaster.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="Transparent">
  <Grid Margin="12,8,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnRefresh" Content="刷新" Width="70" Click="BtnRefresh_Click"/>
        <Button x:Name="BtnExportCsv" Content="导出会话 CSV" Width="112" Margin="8,0,0,0" Click="BtnExportCsv_Click"/>
        <Button x:Name="BtnExportDetail" Content="导出明细 CSV" Width="112" Margin="8,0,0,0" Click="BtnExportDetail_Click"/>
        <Button x:Name="BtnExportHtml" Content="导出 HTML 报告" Width="124" Margin="8,0,0,0" Click="BtnExportHtml_Click"/>
        <Button x:Name="BtnOpenData" Content="打开数据目录" Width="108" Margin="8,0,0,0" Click="BtnOpenData_Click"/>
      </StackPanel>
      <TextBlock x:Name="TxtInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
    </Grid>

    <ListView Grid.Row="1" x:Name="LvEntries" Style="{StaticResource TablesListView}" SelectionMode="Single"
              AutomationProperties.AutomationId="LvHistory" SelectionChanged="LvEntries_SelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding TimeText}"/>
          <GridViewColumn Header="类型" Width="66" DisplayMemberBinding="{Binding KindText}"/>
          <GridViewColumn Header="模式" Width="104" DisplayMemberBinding="{Binding ModeText}"/>
          <GridViewColumn Header="文件数" Width="80" DisplayMemberBinding="{Binding FilesText}"/>
          <GridViewColumn Header="释放" Width="92" DisplayMemberBinding="{Binding ReleasedText}"/>
          <GridViewColumn Header="备份区" Width="92" DisplayMemberBinding="{Binding BackedText}"/>
          <GridViewColumn Header="回收站" Width="88" DisplayMemberBinding="{Binding TrashedText}"/>
          <GridViewColumn Header="跳过" Width="66" DisplayMemberBinding="{Binding SkippedText}"/>
          <GridViewColumn Header="状态" Width="76" DisplayMemberBinding="{Binding StatusText}"/>
          <GridViewColumn Header="备注" Width="300" DisplayMemberBinding="{Binding NotesText}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <Border Grid.Row="2" Margin="0,8,0,0" Height="224" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtDetailTitle" Margin="10,8,10,4" Style="{StaticResource SectionText}" Text="选中一条记录查看明细"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListView x:Name="LvCategoryDetail" BorderThickness="0" Background="Transparent" Margin="0">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="类别" Width="190" DisplayMemberBinding="{Binding NameText}"/>
                <GridViewColumn Header="策略" Width="96" DisplayMemberBinding="{Binding StrategyText}"/>
                <GridViewColumn Header="文件数" Width="72" DisplayMemberBinding="{Binding FilesText}"/>
                <GridViewColumn Header="大小" Width="92" DisplayMemberBinding="{Binding SizeText}"/>
                <GridViewColumn Header="跳过" Width="60" DisplayMemberBinding="{Binding SkippedText}"/>
              </GridView>
            </ListView.View>
          </ListView>
          <ScrollViewer Grid.Column="1" Margin="8,0,10,0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtDetailNotes" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2Brush}"/>
          </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" Margin="10,4,10,8" Style="{StaticResource MutedText}"
                   Text="台账记录保存在本地数据目录（ledger.jsonl），应用重启后不会丢失。"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
