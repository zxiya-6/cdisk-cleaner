<UserControl x:Class="CleanMaster.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="Transparent">
  <Grid Margin="12,8,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="备份区：" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/>
        <TextBlock x:Name="TxtRoot" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextBrush}"/>
        <Button Content="打开目录" Width="84" Margin="10,0,0,0" Click="BtnOpenRoot_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="TxtStats" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
        <Button x:Name="BtnRefresh" Content="刷新" Width="70" Click="BtnRefresh_Click"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="BtnRestore" Content="恢复选中会话…" Style="{StaticResource PrimaryButton}" Width="132"
              AutomationProperties.AutomationId="BtnRestore" Click="BtnRestore_Click"/>
      <TextBlock Text="冲突处理：" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Text2Brush}"/>
      <ComboBox x:Name="CmbConflict" Width="140" SelectedIndex="0">
        <ComboBoxItem Content="保留两者（改名恢复）" Tag="rename"/>
        <ComboBoxItem Content="跳过已存在文件" Tag="skip"/>
        <ComboBoxItem Content="覆盖已存在文件" Tag="overwrite"/>
      </ComboBox>
      <Button x:Name="BtnPurgeSel" Content="清空选中会话…" Width="128" Margin="16,0,0,0" Click="BtnPurgeSel_Click"/>
      <Button x:Name="BtnPurgeAll" Content="清空全部…" Width="96" Margin="8,0,0,0" Click="BtnPurgeAll_Click"/>
    </StackPanel>

    <ListView Grid.Row="2" x:Name="LvSessions" Style="{StaticResource TablesListView}" SelectionMode="Extended"
              AutomationProperties.AutomationId="LvSessions" SelectionChanged="LvSessions_SelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="42">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="会话" Width="170" DisplayMemberBinding="{Binding Id}"/>
          <GridViewColumn Header="时间" Width="160" DisplayMemberBinding="{Binding CreatedText}"/>
          <GridViewColumn Header="剩余文件" Width="90" DisplayMemberBinding="{Binding RemainingText}"/>
          <GridViewColumn Header="剩余大小" Width="110" DisplayMemberBinding="{Binding BytesText}"/>
          <GridViewColumn Header="已恢复" Width="80" DisplayMemberBinding="{Binding RestoredText}"/>
          <GridViewColumn Header="已清空" Width="80" DisplayMemberBinding="{Binding PurgedText}"/>
          <GridViewColumn Header="类别" Width="260" DisplayMemberBinding="{Binding CategoriesText}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <Border Grid.Row="3" Margin="0,8,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="1" CornerRadius="4" Padding="0" Height="210">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtDetailTitle" Margin="10,8,10,4" Style="{StaticResource SectionText}"
                   Text="选中会话后可查看其中的文件（前 500 条）"/>
        <ListView Grid.Row="1" x:Name="LvItems" BorderThickness="0" Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="大小" Width="96" DisplayMemberBinding="{Binding SizeText}"/>
              <GridViewColumn Header="原始路径" Width="900" DisplayMemberBinding="{Binding PathText}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </Border>
  </Grid>
</UserControl>
