<UserControl x:Class="CleanMaster.App.Views.BigFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="Transparent">
  <Grid Margin="12,8,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="扫描位置：" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/>
        <TextBox x:Name="TxtRoot" Width="280" Text="C:\"/>
        <Button Content="浏览…" Width="70" Margin="6,0,0,0" Click="BtnBrowse_Click"/>
        <TextBlock Text="最小文件：" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Text2Brush}"/>
        <ComboBox x:Name="CmbMinSize" Width="104" SelectedIndex="0">
          <ComboBoxItem Content="100 MB" Tag="100"/>
          <ComboBoxItem Content="300 MB" Tag="300"/>
          <ComboBoxItem Content="500 MB" Tag="500"/>
          <ComboBoxItem Content="1 GB" Tag="1024"/>
        </ComboBox>
        <Button x:Name="BtnScan" Content="开始扫描" Style="{StaticResource PrimaryButton}" Width="110" Margin="16,0,0,0"
                AutomationProperties.AutomationId="BtnBigScan" Click="BtnScan_Click"/>
      </StackPanel>
      <TextBlock x:Name="TxtInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
    </Grid>

    <ListView Grid.Row="1" x:Name="LvFiles" Style="{StaticResource TablesListView}" SelectionMode="Extended"
              AutomationProperties.AutomationId="LvBigFiles" SelectionChanged="LvFiles_SelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="42">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
          <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding DateText}"/>
          <GridViewColumn Header="路径" Width="700" DisplayMemberBinding="{Binding FullPath}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnOpen" Content="打开所在位置" Width="122" IsEnabled="False" Click="BtnOpen_Click"/>
        <Button x:Name="BtnCopy" Content="复制路径" Width="92" Margin="8,0,0,0" IsEnabled="False" Click="BtnCopy_Click"/>
        <Button x:Name="BtnRecycle" Content="移到回收站…" Width="122" Margin="8,0,0,0" IsEnabled="False" Click="BtnRecycle_Click"/>
      </StackPanel>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedText}"
                 Text="扫描只读取文件信息；删除动作需要确认，且默认移入回收站可恢复。"/>
    </Grid>
  </Grid>
</UserControl>
