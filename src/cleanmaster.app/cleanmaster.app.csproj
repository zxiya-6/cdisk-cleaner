<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>11</LangVersion>
    <RootNamespace>CleanMaster.App</RootNamespace>
    <AssemblyName>C盘清理助手</AssemblyName>
    <Version>5.0.0</Version>
    <Product>C盘清理助手</Product>
    <AssemblyTitle>C盘清理助手</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanMaster.Core\CleanMaster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="rules" />
  </ItemGroup>

</Project>
