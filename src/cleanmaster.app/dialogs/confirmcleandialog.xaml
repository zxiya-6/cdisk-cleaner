<Window x:Class="CleanMaster.App.Dialogs.ConfirmCleanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清理" Width="880" Height="660" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="TxtHeader" Style="{StaticResource H1Text}" Text="确认清理"/>
      <TextBlock x:Name="TxtTotals" Style="{StaticResource Body2Text}" Margin="0,4,0,0"/>
    </StackPanel>

    <ListView Grid.Row="1" x:Name="LvItems" Margin="0,12,0,0" Style="{StaticResource TablesListView}" SelectionMode="Single" MinHeight="180">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="类别" Width="188" DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn Header="说明" Width="250" DisplayMemberBinding="{Binding NoteText}"/>
          <GridViewColumn Header="风险" Width="68" DisplayMemberBinding="{Binding RiskText}"/>
          <GridViewColumn Header="策略" Width="80" DisplayMemberBinding="{Binding StrategyText}"/>
          <GridViewColumn Header="文件数" Width="80" DisplayMemberBinding="{Binding FilesText}"/>
          <GridViewColumn Header="大小" Width="92" DisplayMemberBinding="{Binding SizeText}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="TxtWarnings" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12.5" Margin="0,0,0,10"/>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
        <StackPanel>
          <TextBlock Text="清理方式" Style="{StaticResource SectionText}"/>
          <RadioButton x:Name="RbStandard" GroupName="CleanMode" IsChecked="True" Content="标准清理（推荐）：按各类别安全策略执行 — 缓存与临时文件永久删除；浏览历史/下载等移至回收站或备份区"/>
          <RadioButton x:Name="RbBackup" GroupName="CleanMode" Margin="0,6,0,0" Content="全部先备份：所有文件移入备份区（最稳妥，可随时恢复；清空备份区后才释放空间）"/>
          <RadioButton x:Name="RbPermanent" GroupName="CleanMode" Margin="0,6,0,0" Content="全部永久删除：立即释放空间，不可恢复（请谨慎选择）"/>
          <CheckBox x:Name="ChkRestorePoint" Margin="0,10,0,0" Content="清理前创建系统还原点（推荐，若系统还原不可用会自动跳过）"/>
          <CheckBox x:Name="ChkAck" Margin="0,10,0,0" FontWeight="SemiBold" Visibility="Collapsed"
                    Content="我已了解上述高风险项的后果，并确认清理"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnCancel" Content="取消" Width="92" Click="BtnCancel_Click"/>
      <Button x:Name="BtnOk" Content="开始清理" Width="126" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click"/>
    </StackPanel>
  </Grid>
</Window>
