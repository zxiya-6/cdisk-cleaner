{
  "schemaVersion": 1,
  "updated": "2026-09-16",
  "categories": [
    {
      "id": "user-temp",
      "group": "系统清理",
      "name": "用户临时文件",
      "note": "清理 /tmp 中当前用户可删除的临时文件；以管理员运行时将清理全部。",
      "kind": "dirContents",
      "paths": [ "/tmp" ],
      "includeFiles": [ "*" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "requiresAdmin": false
    },
    {
      "id": "var-tmp",
      "group": "系统清理",
      "name": "系统临时文件",
      "note": "/var/tmp 存放系统级临时文件（重启后保留），建议管理员权限执行。",
      "kind": "dirContents",
      "paths": [ "/var/tmp" ],
      "includeFiles": [ "*" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": false,
      "recommend": true,
      "requiresAdmin": true
    },
    {
      "id": "old-logs",
      "group": "系统清理",
      "name": "轮转旧日志",
      "note": "仅删除已轮转的压缩/编号日志（如 syslog.1、kern.log.2.gz），不影响正在写入的日志；使用 journald 的日志请用 journal-vacuum 命令。",
      "kind": "dirContents",
      "paths": [ "/var/log" ],
      "includeFiles": [ "*.gz", "*.xz", "*.old", "*.1", "*.2", "*.3", "*.4", "*.5", "*.6", "*.7", "*.8", "*.9" ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false,
      "requiresAdmin": true
    },
    {
      "id": "apt-cache",
      "group": "系统清理",
      "name": "APT 软件包缓存",
      "note": "等价于 apt-get clean；仅删除已下载的 .deb 安装包缓存，不影响已安装软件。",
      "kind": "dirContents",
      "paths": [ "/var/cache/apt/archives" ],
      "includeFiles": [ "*.deb" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "requiresAdmin": true
    },
    {
      "id": "dnf-cache",
      "group": "系统清理",
      "name": "DNF/YUM 软件包缓存",
      "note": "等价于 dnf clean all / yum clean all；删除后重新安装时需重新下载。",
      "kind": "dirContents",
      "paths": [ "/var/cache/dnf", "/var/cache/yum" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "requiresAdmin": true
    },
    {
      "id": "pacman-cache",
      "group": "系统清理",
      "name": "pacman 软件包缓存",
      "note": "等价于 pacman -Sc（仅清缓存包，不影响已安装软件）。",
      "kind": "dirContents",
      "paths": [ "/var/cache/pacman/pkg" ],
      "includeFiles": [ "*.pkg.tar.zst", "*.pkg.tar.xz", "*.pkg.tar.gz" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "requiresAdmin": true
    },
    {
      "id": "thumbnails",
      "group": "桌面与应用缓存",
      "name": "文件管理器缩略图缓存",
      "note": "删除后文件管理器会自动重建缩略图。",
      "kind": "dirContents",
      "paths": [ "~/.cache/thumbnails" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true
    },
    {
      "id": "fontconfig-cache",
      "group": "桌面与应用缓存",
      "name": "字体缓存",
      "note": "删除后系统会自动重建字体缓存。",
      "kind": "dirContents",
      "paths": [ "~/.cache/fontconfig" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true
    },
    {
      "id": "chrome-cache",
      "group": "桌面与应用缓存",
      "name": "Chrome 浏览器缓存",
      "note": "仅清理磁盘缓存（图片/脚本），不影响历史、密码与登录状态。",
      "kind": "dirContents",
      "paths": [
        "~/.cache/google-chrome/*/Cache",
        "~/.cache/google-chrome/*/Code Cache",
        "~/.cache/google-chrome/*/GPUCache",
        "~/.cache/google-chrome/*/Service Worker/CacheStorage",
        "~/.cache/google-chrome/ShaderCache",
        "~/.cache/google-chrome/GrShaderCache"
      ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "warnProcesses": [ "google-chrome", "chrome" ]
    },
    {
      "id": "chromium-cache",
      "group": "桌面与应用缓存",
      "name": "Chromium 浏览器缓存",
      "note": "仅清理磁盘缓存，不影响历史、密码与登录状态。",
      "kind": "dirContents",
      "paths": [
        "~/.cache/chromium/*/Cache",
        "~/.cache/chromium/*/Code Cache",
        "~/.cache/chromium/*/GPUCache",
        "~/.cache/chromium/*/Service Worker/CacheStorage",
        "~/.cache/chromium/ShaderCache",
        "~/.cache/chromium/GrShaderCache"
      ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "warnProcesses": [ "chromium", "chromium-browser" ]
    },
    {
      "id": "edge-cache",
      "group": "桌面与应用缓存",
      "name": "Edge 浏览器缓存",
      "note": "仅清理磁盘缓存，不影响历史、密码与登录状态。",
      "kind": "dirContents",
      "paths": [
        "~/.cache/microsoft-edge/*/Cache",
        "~/.cache/microsoft-edge/*/Code Cache",
        "~/.cache/microsoft-edge/*/GPUCache",
        "~/.cache/microsoft-edge/*/Service Worker/CacheStorage",
        "~/.cache/microsoft-edge/ShaderCache",
        "~/.cache/microsoft-edge/GrShaderCache"
      ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "warnProcesses": [ "microsoft-edge" ]
    },
    {
      "id": "firefox-cache",
      "group": "桌面与应用缓存",
      "name": "Firefox 缓存",
      "note": "仅清理磁盘缓存，不影响浏览历史与书签。",
      "kind": "dirContents",
      "paths": [ "~/.cache/mozilla/firefox/*/cache2" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true,
      "warnProcesses": [ "firefox" ]
    },
    {
      "id": "chrome-history",
      "group": "桌面与应用缓存",
      "name": "Chrome 浏览历史",
      "note": "删除浏览历史（移入回收站，可恢复）。",
      "kind": "files",
      "paths": [
        "~/.config/google-chrome/*/History",
        "~/.config/google-chrome/*/History-journal"
      ],
      "strategy": "trash",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false,
      "warnProcesses": [ "google-chrome", "chrome" ]
    },
    {
      "id": "chrome-cookies",
      "group": "桌面与应用缓存",
      "name": "Chrome Cookie",
      "note": "清除登录状态，需重新登录网站。",
      "kind": "files",
      "paths": [
        "~/.config/google-chrome/*/Network/Cookies",
        "~/.config/google-chrome/*/Network/Cookies-journal"
      ],
      "strategy": "trash",
      "risk": "high",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false,
      "warnProcesses": [ "google-chrome", "chrome" ]
    },
    {
      "id": "electron-caches",
      "group": "桌面与应用缓存",
      "name": "Electron 应用缓存",
      "note": "覆盖 VS Code、Discord 等 Electron 应用；不影响应用配置与用户数据。",
      "kind": "dirContents",
      "paths": [
        "~/.config/*/Cache",
        "~/.config/*/GPUCache",
        "~/.config/*/Code Cache"
      ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "vscode-cache",
      "group": "桌面与应用缓存",
      "name": "VS Code 缓存",
      "note": "删除后 VS Code 与扩展缓存将自动重建。",
      "kind": "dirContents",
      "paths": [
        "~/.cache/Code/Cache",
        "~/.cache/Code/CachedData",
        "~/.cache/Code/GPUCache",
        "~/.cache/Code/Code Cache",
        "~/.config/Code/logs",
        "~/.cache/Microsoft/vscode-cpptools"
      ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": false,
      "recommend": true,
      "warnProcesses": [ "code" ]
    },
    {
      "id": "jetbrains-caches",
      "group": "桌面与应用缓存",
      "name": "JetBrains IDE 索引与缓存",
      "note": "删除后 IDE 会重建索引，首次打开略慢；不影响项目与配置。",
      "kind": "dirContents",
      "paths": [
        "~/.cache/JetBrains/*/caches",
        "~/.cache/JetBrains/*/index"
      ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": true,
      "warnProcesses": [ "idea", "pycharm", "webstorm", "clion", "goland", "phpstorm", "rider" ]
    },
    {
      "id": "npm-cache",
      "group": "开发工具缓存",
      "name": "npm 缓存",
      "note": "等价于 npm cache clean --force；删除后重新 npm install 会重新下载。",
      "kind": "dirContents",
      "paths": [ "~/.npm/_cacache" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true
    },
    {
      "id": "pnpm-store",
      "group": "开发工具缓存",
      "name": "pnpm 存储",
      "note": "pnpm 内容寻址存储；删除后项目依赖需重新安装。",
      "kind": "dirContents",
      "paths": [ "~/.local/share/pnpm/store" ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "yarn-cache",
      "group": "开发工具缓存",
      "name": "yarn 缓存",
      "note": "删除后重新 yarn install 会重新下载。",
      "kind": "dirContents",
      "paths": [ "~/.cache/yarn" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true
    },
    {
      "id": "pip-cache",
      "group": "开发工具缓存",
      "name": "pip 缓存",
      "note": "删除后重新 pip install 会重新下载。",
      "kind": "dirContents",
      "paths": [ "~/.cache/pip" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": true,
      "recommend": true
    },
    {
      "id": "cargo-cache",
      "group": "开发工具缓存",
      "name": "Cargo 注册表缓存",
      "note": "删除后下次 cargo build 需重新下载依赖。",
      "kind": "dirContents",
      "paths": [ "~/.cargo/registry" ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "go-build-cache",
      "group": "开发工具缓存",
      "name": "Go 构建缓存",
      "note": "等价于 go clean -cache；不会影响已编译产物。",
      "kind": "dirContents",
      "paths": [ "~/.cache/go-build" ],
      "strategy": "delete",
      "risk": "safe",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "nuget-cache",
      "group": "开发工具缓存",
      "name": "NuGet 全局包缓存",
      "note": "删除后还原项目依赖时需重新下载。",
      "kind": "dirContents",
      "paths": [ "~/.nuget/packages" ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "gradle-cache",
      "group": "开发工具缓存",
      "name": "Gradle 缓存",
      "note": "删除后 Gradle 构建需重新下载依赖。",
      "kind": "dirContents",
      "paths": [ "~/.gradle/caches" ],
      "strategy": "delete",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "recent-files",
      "group": "数据与隐私",
      "name": "最近打开文件记录",
      "note": "清除最近打开文件列表（GTK 应用），移入回收站。",
      "kind": "files",
      "paths": [ "~/.local/share/recently-used.xbel" ],
      "strategy": "trash",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "trash",
      "group": "数据与隐私",
      "name": "回收站",
      "note": "清空 freedesktop 回收站（~/.local/share/Trash），不可恢复。",
      "kind": "emptyRecycleBin",
      "strategy": "delete",
      "risk": "high",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false
    },
    {
      "id": "downloads-old-installers",
      "group": "数据与隐私",
      "name": "下载目录中的旧安装包",
      "note": "移入回收站（可恢复），仅处理 30 天前下载的安装包/压缩包。",
      "kind": "dirContents",
      "paths": [ "~/Downloads" ],
      "includeFiles": [
        "*.deb", "*.rpm", "*.pkg.tar.zst", "*.pkg.tar.xz", "*.pkg.tar.gz",
        "*.AppImage", "*.zip", "*.tar.gz", "*.tgz", "*.tar.xz", "*.tar.bz2",
        "*.7z", "*.rar", "*.iso"
      ],
      "strategy": "trash",
      "risk": "moderate",
      "enabled": true,
      "defaultChecked": false,
      "recommend": false,
      "minAgeDays": 30
    }
  ]
}
