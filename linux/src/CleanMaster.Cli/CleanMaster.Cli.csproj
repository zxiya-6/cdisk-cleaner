<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>CleanMaster.Cli</RootNamespace>
    <AssemblyName>CleanMasterCli</AssemblyName>
    <Version>1.0.0</Version>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanMaster.Core\CleanMaster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="rules" />
  </ItemGroup>

</Project>
